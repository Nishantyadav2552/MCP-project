{
  "name": "canva-cursor",
  "version": "0.1.0",
  "private": true,
  "description": "An Agentic AI System for Intelligent Design Editing in Canva",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:bridge": "npm run dev --workspace=@canva-cursor/bridge",
    "dev:web": "npm run dev --workspace=@canva-cursor/web",
    "test:phase1": "node --test tests/integration/phase1.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
