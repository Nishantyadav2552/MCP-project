{
  "name": "canva-cursor",
  "version": "0.1.0",
  "private": true,
  "description": "An Agentic AI System for Intelligent Design Editing in Canva",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:bridge": "npm run dev --workspace=@canva-cursor/bridge",
    "dev:web": "npm run dev --workspace=@canva-cursor/web",
    "test:phase1": "node --test tests/integration/phase1.test.mjs",
    "test:phase2": "node --test tests/unit/knowledge-graph.test.mjs",
    "test:phase3": "node --test tests/unit/mcp-tools.test.mjs",
    "test:phase4": "node --test tests/integration/agent-planner.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.4.5"
  }
}
