{
  "$schema": "https://www.canva.dev/schemas/app/v1/manifest-schema.json",
  "manifest_schema_version": 1,
  "app_name": "Canva Cursor",
  "app_id": "app_canva_cursor_ai",
  "description": "An Agentic AI System for Intelligent Design Editing in Canva",
  "runtime": {
    "permissions": [
      {
        "name": "canva:design:content:read",
